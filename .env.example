# Optional: store RSVPs in Supabase. Without these, replies are only logged to the server console.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: email each guest reply to the couple (https://resend.com). The sender domain must be verified in Resend.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Your Names <hello@your-domain.com>"
EMAIL_TO=one@example.com, two@example.com
EMAIL_BCC=hidden@example.com
